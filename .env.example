# Copy to .env and load it however you prefer (e.g. `node --env-file=.env server/index.js`)
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@bmv.com
ADMIN_PASSWORD=admin123

# Frontend (optional): point at a deployed API instead of the Vite proxy
# VITE_API_URL=https://your-api.example.com/api

# Demo login: any email/password signs in (new emails get an account). Set to false for real logins.
DEMO_LOGIN=true
